# Server-side Graph8 API key only. Never put it in a VITE_* variable.
G8_API_KEY=

# Server-side Gemini API key. Never put it in a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set true only when the app is access-protected; each draft uses Gemini quota.
DEALDISPATCH_ENABLE_GEMINI=false

# Set true only behind Vercel Deployment Protection or equivalent access control.
DEALDISPATCH_ENABLE_TASK_WRITES=false

# Optional server port (default: 4174)
PORT=4174
